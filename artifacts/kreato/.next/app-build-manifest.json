{
  "pages": {
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ],
    "/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/page.js"
    ],
    "/[handle]/not-found": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[handle]/not-found.js"
    ],
    "/[handle]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[handle]/page.js"
    ],
    "/waitlist/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/waitlist/page.css",
      "static/chunks/app/waitlist/page.js"
    ]
  }
}